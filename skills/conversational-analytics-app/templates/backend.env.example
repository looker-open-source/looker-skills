# Env vars read by backend_sse_relay.py, create_data_agent.py-style setup
# scripts, and smoke_test.py. Copy to `.env` and fill in — never commit the
# filled-in file (see ../reference/backend-deployment.md, "Secrets & config").

# Required. GCP project id — see reference/data-agent-context.md.
PROJECT_ID=

# Optional, defaults to "global". The Conversational Analytics API location,
# NOT the Cloud Run region — those are set independently (--region on
# `gcloud run deploy`). See reference/backend-deployment.md.
LOCATION=global

# Required. Full resource name of the persistent DataAgent, e.g.
# projects/PROJECT_ID/locations/LOCATION/dataAgents/AGENT_ID. Create it once
# via DataAgentServiceClient.create_data_agent() — see
# reference/data-agent-context.md — then paste the printed name here.
DATA_AGENT_NAME=

# CORS: the frontend's origin. Default "*" is fine for local testing only —
# tighten to the deployed frontend's actual origin before sharing this
# beyond your own machine (reference/backend-deployment.md).
FRONTEND_ORIGIN=*

# Optional, defaults to "{PROJECT_ID}.analytics.feedback". BigQuery table
# for 5-star + comment feedback capture — must already exist (DDL in
# reference/feedback-capture.md) before /feedback will work.
FEEDBACK_TABLE=

# Optional — only needed if the data source is Looker AND
# backend_sse_relay.py is extended to set ChatRequest.credentials (the base
# template doesn't wire these in by default). Generate from the Looker admin
# interface. See "Looker authentication" in reference/data-agent-context.md.
LOOKER_CLIENT_ID=
LOOKER_CLIENT_SECRET=
